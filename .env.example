# PK-MRP environment. Copy to .env (git-ignored) for a local run; the deployed
# values live in pk-server-manager's governed env file, never in this repo.

# PK-SQL01: ExactMAXPKLive is read-only (the login has SELECT only); PK_Ops is
# PK-MRP's app state (mrp_* tables, created by the DBA from deploy/pk_ops_schema.sql).
DB_SERVER=PK-SQL01
DB_PORT=1433
DB_USER=app_control_tower
DB_PASSWORD=
ERP_DATABASE=ExactMAXPKLive
OPS_DATABASE=PK_Ops

# sql (deployed, Linux) | windows (Trusted_Connection, laptop only)
ERP_AUTH=sql
